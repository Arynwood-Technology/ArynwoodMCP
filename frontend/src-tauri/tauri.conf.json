{
  "productName": "arynwood-mcp",
  "version": "0.4.4",
  "identifier": "com.arynwood.mcp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Arynwood MCP",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "create": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:* ws://localhost:* 'unsafe-inline' 'unsafe-eval'; img-src 'self' data: blob: https: http:; media-src 'self' blob: data: http://localhost:*; font-src 'self' data: https://fonts.gstatic.com https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; connect-src 'self' ipc://localhost http://localhost:* ws://localhost:* https: blob: data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/arynwood-backend"],
    "category": "DeveloperTool",
    "shortDescription": "Local-first AI workspace for the Linux desktop",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true,
        "files": {
          "/usr/share/metainfo/com.arynwood.mcp.metainfo.xml": "linux/com.arynwood.mcp.metainfo.xml"
        }
      },
      "deb": {
        "files": {
          "/usr/share/metainfo/com.arynwood.mcp.metainfo.xml": "linux/com.arynwood.mcp.metainfo.xml"
        }
      }
    }
  }
}
