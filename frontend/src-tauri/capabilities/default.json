{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default Arynwood MCP window capability",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "notification:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/arynwood-backend",
          "sidecar": true,
          "args": false
        }
      ]
    }
  ]
}
