# Exclude model weights, checkpoints, audio/video outputs
# (path is triggers/gpu_watch/, not gpu_watch/ at root — no leading slash,
# so this matches regardless of nesting depth. chatterbox_voices/ is
# reference data the Chatterbox tool needs, so it's deliberately not matched.)
/models/
triggers/gpu_watch/*_output/
triggers/gpu_watch/*_input/
/*.ckpt
/*.safetensors
/**/*.pth
/**/*.pt

# Node and Python artifacts
node_modules/
*.log
*.sqlite
__pycache__/
*.pyc
*.pyo
*.pyd
env/
venv/
.venv/

# PyInstaller backend-sidecar build output and Tauri build output — both
# regenerated by `make package` / CI, never hand-edited, and each dozens of MB.
/build/
/dist/
frontend/src-tauri/binaries/
frontend/src-tauri/target/

# Fine-tuning datasets/checkpoints — corpus text and model weights live outside
# the repo (~/Desktop/novelist-training-corpus/), but this catches anything
# accidentally written under training/ locally too (unpublished manuscripts,
# multi-GB checkpoints — neither belongs in a repo with a real GitHub remote).
training/*/*.jsonl
training/*/checkpoints/

# Generated Music Lab audio (ACE-Step/MusicGen output, stem separations) —
# large binary files, not source, referenced from music_assets in the DB.
music/assets/

# Docker local volumes
docker/n8n/n8n-data/
docker/monitoring/*-data/
docker/monitoring/prometheus/prometheus.yml

# Misc
*.DS_Store
*.swp
*.bak
*.old
*.tmp

# Optional: protect any personal config files
*.env

# NKN wallet (contains private key — never commit)
nkn/wallet.json

# MCP server credentials (contains Bearer tokens)
mcp/config/mcp_servers.json

# User-specific runtime config (IRC bot, etc.)
config/irc_bot.json
config/bots/
!config/bots/example.json
config/*.db
config/*.db-shm
config/*.db-wal

# Local bots (personal scripts — gitignored, use example.json as template)
local-bots/*
!local-bots/example.json
!local-bots/spotify-IRC/

# Desktop launcher (contains local paths)
arynwood-mcp.desktop

.local_logs/

# Local environment secrets
.env

# Tauri build artifacts
frontend/src-tauri/target/
frontend/src-tauri/gen/

# Release bundles — built locally, not committed
*.deb
*.AppImage
*.rpm

# Private personal data (bank statements, financial docs, etc.)
private/

# Keys
*.key
*.pem
*.key
*.pem
local-bots/couch-crew/credentials.json
transcend-hackathon-*
