# Copy to .env and fill in your values.
# This file is committed — .env is gitignored.
# Every variable below is optional — the app runs with none of them set, using the
# defaults shown in comments (localhost services, no auth, loopback-only binding).

# ── Network binding ──────────────────────────────────────────────────────────────
# By default start.sh / arynwood-desktop.sh / arynwood-app.sh bind the backend (and
# Ollama, if this script starts it) to 127.0.0.1 — loopback only, not reachable from
# your LAN. Set these to 0.0.0.0 ONLY if you deliberately want LAN/remote access, and
# set ARYNWOOD_API_KEY too when you do — there's no frontend login flow yet, so an
# exposed, unauthenticated backend is a real risk on a shared network.
# ARYNWOOD_BIND_HOST=0.0.0.0
# OLLAMA_HOST=0.0.0.0

# ── API authentication ───────────────────────────────────────────────────────────
# Gates the whole /api/* surface (HTTP + the chat WebSocket) behind
# `Authorization: Bearer <token>`. No-op unless set — every request passes through
# unauthenticated by default. The WebSocket sends it as a ?token= query param since
# it can't set a custom header.
# ARYNWOOD_API_KEY=

# ── Storage & external services ──────────────────────────────────────────────────
# SQLite DB path. Default: config/arynwood.db relative to the repo root.
# ARYNWOOD_DB_PATH=
# Qdrant vector store (knowledge base + memory index). Default: http://localhost:6333
# QDRANT_URL=http://localhost:6333
# Ollama used by the YouTube auto-publish pipeline specifically (triggers/youtube_watch.py)
# — separate from the interactive chat servers configured in the Servers page.
# Default: http://localhost:11434
# YOUTUBE_PIPELINE_OLLAMA=http://localhost:11434

# ── Jamendo (royalty-free background music search, Video Studio) ────────────────
# Create a client at https://devportal.jamendo.com/ — leaving this unset disables
# just that one feature with a clear in-app message, nothing else is affected.
JAMENDO_CLIENT_ID=

# ── Social Media ───────────────────────────────────────────────────────────────
# Facebook + Instagram (same Meta app — create at developers.facebook.com)
# Required permissions: pages_manage_posts, pages_read_engagement,
#                       instagram_basic, instagram_content_publish
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Google / YouTube (create at console.cloud.google.com → YouTube Data API v3)
# OAuth scopes: youtube.upload, youtube.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn (create at developer.linkedin.com)
# OAuth scopes: r_liteprofile, w_member_social
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Base URL for OAuth callbacks — change if running behind a reverse proxy
SOCIAL_REDIRECT_BASE=http://localhost:8010
